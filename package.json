    "sandbox:deploy": "node --env-file-if-exists=.env.local scripts/kintone/deploy-sandbox-apps.js",
    "sandbox:smoke-test": "node --env-file-if-exists=.env.local scripts/kintone/smoke-test-sandbox-apps.js"
  }
}
